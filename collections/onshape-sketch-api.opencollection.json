      "info": {
        "name": "Sketch",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get information for all sketches in Part Studio.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cad.onshape.com/api/v16/partstudios/d/:did/:wvm/:wvmid/e/:eid/sketches",
            "params": [
              {
                "name": "did",
                "value": "",
                "type": "path"
              },
              {
                "name": "wvm",
                "value": "",
                "type": "path"
              },
              {
                "name": "wvmid",
                "value": "",
                "type": "path"
              },
              {
                "name": "eid",
                "value": "",
                "type": "path"
              },
              {
                "name": "configuration",
                "value": "",
                "type": "query",
                "description": "URL-encoded string of configuration values (separated by `;`). See the [Configurations API Guide](https://onshape-public.github.io/docs/api-adv/configs/) for details."
              },
              {
                "name": "sketchId",
                "value": "",
                "type": "query"
              },
              {
                "name": "output3D",
                "value": "",
                "type": "query"
              },
              {
                "name": "curvePoints",
                "value": "",
                "type": "query"
              },
              {
                "name": "includeGeometry",
                "value": "",
                "type": "query"
              },
              {
                "name": "linkDocumentId",
                "value": "",
                "type": "query",
                "description": "Id of document that links to the document being accessed. This may provide additional access rights to the document. Allowed only with version (v) path parameter."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "/oauth/authorize",
              "accessTokenUrl": "/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get information for all sketches in Part Studio."
