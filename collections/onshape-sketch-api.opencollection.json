        {
          "info": {
            "name": "Get the tessellations of a sketch in a Part Studio.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cad.onshape.com/api/v16/partstudios/d/:did/:wvm/:wvmid/e/:eid/sketches/:sid/tessellatedentities",
            "params": [
              {
                "name": "did",
                "value": "",
                "type": "path"
              },
              {
                "name": "wvm",
                "value": "",
                "type": "path"
              },
              {
                "name": "wvmid",
                "value": "",
                "type": "path"
              },
              {
                "name": "eid",
                "value": "",
                "type": "path"
              },
              {
                "name": "sid",
                "value": "",
                "type": "path"
              },
              {
                "name": "configuration",
                "value": "",
                "type": "query"
              },
              {
                "name": "entityId",
                "value": "",
                "type": "query"
              },
              {
                "name": "angleTolerance",
                "value": "",
                "type": "query"
              },
              {
                "name": "chordTolerance",
                "value": "",
