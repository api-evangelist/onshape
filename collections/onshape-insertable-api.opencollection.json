{
  "opencollection": "1.0.0",
  "info": {
    "name": "Onshape REST Account Insertable API",
    "version": "1.218.84032-34acba44be17"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Insertable",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a list of things in this document that can be inserted elsewhere.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cad.onshape.com/api/v16/insertables/d/:did/latest",
            "params": [
              {
                "name": "did",
                "value": "",
                "type": "path"
              },
              {
                "name": "includeParts",
                "value": "",
                "type": "query"
              },
              {
                "name": "includeSurfaces",
                "value": "",
                "type": "query"
              },
              {
                "name": "includeSketches",
                "value": "",
                "type": "query"
              },
              {
                "name": "includeReferenceFeatures",
                "value": "",
                "type": "query"
              },
              {
                "name": "includeAssemblies",
                "value": "",
                "type": "query"
              },
              {
                "name": "includeFeatureStudios",
                "value": "",
                "type": "query"
              },
              {
                "name": "includeBlobs",
                "value": "",
                "type": "query"
              },
              {
                "name": "allowedBlobMimeTypes",
                "value": "",
                "type": "query"
              },
              {
                "name": "excludeNewerFSVersions",
                "value": "",
                "type": "query"
              },
              {
                "name": "maxFeatureScriptVersion",
                "value": "",
                "type": "query"
              },
              {
                "name": "includePartStudios",
                "value": "",
                "type": "query"
              },
              {
                "name": "includeFeatures",
                "value": "",
                "type": "query"
              },
              {
                "name": "includeMeshes",
                "value": "",
                "type": "query"
              },
              {
                "name": "includeWires",
                "value": "",
                "type": "query"
              },
              {
                "name": "includeFlattenedBodies",
                "value": "",
                "type": "query"
              },
              {
                "name": "includeApplications",
                "value": "",
                "type": "query"
              },
              {
                "name": "allowedApplicationMimeTypes",
                "value": "",
                "type": "query"
              },
              {
                "name": "includeCompositeParts",
                "value": "",
                "type": "query"
              },
              {
                "name": "includeFSTables",
                "value": "",
                "type": "query"
              },
              {
                "name": "includeFSComputedPartPropertyFunctions",
                "value": "",
                "type": "query"
              },
              {
                "name": "includeVariables",
                "value": "",
                "type": "query"
              },
              {
                "name": "includeVariableStudios",
                "value": "",
                "type": "query"
              },
              {
                "name": "allowedBlobExtensions",
                "value": "",
                "type": "query"
              },
              {
                "name": "isObsoletion",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "/oauth/authorize",
              "accessTokenUrl": "/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "* Returns only the latest revision of released insertables. \n* Use the document ID (`did`) parameter to specify the source document, not the insertion target. \n* For example, you can insert a custom Feature library into another custom Feature library, insert Parts into an Assembly or a Drawing, etc."
        }
      ]
    }
  ],
  "bundled": true
}