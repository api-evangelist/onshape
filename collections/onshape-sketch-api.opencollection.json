{
  "opencollection": "1.0.0",
  "info": {
    "name": "Onshape REST Account Sketch API",
    "version": "1.218.84032-34acba44be17"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
